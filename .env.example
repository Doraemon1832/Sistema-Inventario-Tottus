# Copy to .env for LOCAL DEVELOPMENT only, then replace every value.
MYSQL_DATABASE=inv_tottus_db
MYSQL_USER=tottus_local
MYSQL_PASSWORD=replace_with_a_local_password
MYSQL_ROOT_PASSWORD=replace_with_a_different_local_password
MYSQL_PORT=3307
BACKEND_PORT=8080
FRONTEND_PORT=4200
SPRING_PROFILES_ACTIVE=default
# Base64 encoded secret with at least 32 decoded bytes. Generate a unique value for each environment.
JWT_SECRET=REPLACE_WITH_BASE64_ENCODED_32_BYTE_RANDOM_SECRET
